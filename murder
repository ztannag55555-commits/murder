-- ====================================

local function findRoleSelector()
    local main = PlayerGui:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local selector =
        gameGui and gameGui:FindFirstChild("RoleSelector")

    if selector and selector:IsA("GuiObject") then
        return selector
    end

    return nil
end

local function bindRole()
    local selector = findRoleSelector()

    if selector == RoleSelector then
        return
    end

    if RoleConnection then
        RoleConnection:Disconnect()
        RoleConnection = nil
    end

    RoleSelector = selector

    if not selector then
        LastRoleVisible = false
        return
    end

    LastRoleVisible = selector.Visible

    RoleConnection =
        selector:GetPropertyChangedSignal("Visible")
        :Connect(function()
            if not Running then return end

            local visible = selector.Visible
            local previous = LastRoleVisible

            LastRoleVisible = visible

            if visible and not previous then
                RoundActive = true
                BagFull = false
                ResetRequested = false

                table.clear(Ignored)
                resetTarget()
                resetInitialDrop()
            end
        end)
end

-- ====================================
-- DETECTAR BOLSA CHEIA
-- ====================================

local function isVisible(object)
    local current = object

    while current and current ~= PlayerGui do
        if current:IsA("GuiObject")
            and not current.Visible then
            return false
        end

        if current:IsA("ScreenGui")
            and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    return current == PlayerGui
end

local function checkBag()
    if not RoundActive or BagFull then
        return
    end

    local main = PlayerGui:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local bags = gameGui and gameGui:FindFirstChild("CoinBags")

    local notification =
        bags and bags:FindFirstChild(
            "FullBagNotification",
            true
        )

    if not notification or not isVisible(notification) then
        return
    end

    local function hasFullText(object)
        if object:IsA("TextLabel")
            or object:IsA("TextButton") then

            return string.find(
                string.upper(object.Text),
                "COIN BAG FULL!",
                1,
                true
            ) ~= nil
        end

        return false
    end

    if hasFullText(notification) then
        BagFull = true
        return
    end

    for _, child in ipairs(notification:GetDescendants()) do
        if hasFullText(child) then
            BagFull = true
            return
        end
    end
end


local function shutdown()
    if not Running then return end

    Running = false
    Enabled = false

    resetFarm()

    if RoleConnection then
        RoleConnection:Disconnect()
        RoleConnection = nil
    end

    disconnect(CharacterConnections)
    disconnect(Connections)
    table.clear(BodyParts)
    table.clear(CoinCandidates)
    table.clear(Coins)
    table.clear(Ignored)

    Gui:Destroy()

    if shared[KEY] == shutdown then
        shared[KEY] = nil
    end

    print("[ZYON] Farm v7.6 encerrada.")
end


-- Infection may replace body parts without firing CharacterAdded.
-- Rebind only this character's parts; keep the current round and settings.
local BodyRevision = 0
local DeathConnection
local function clearDeathConnection()
    if not DeathConnection then return end
    DeathConnection:Disconnect()
    local index = table.find(CharacterConnections, DeathConnection)
    if index then table.remove(CharacterConnections, index) end
    DeathConnection = nil
end
local function refreshBody(character, revision)
    if not Running or revision ~= BodyRevision or Character ~= character
        or Player.Character ~= character then return end
    local newHumanoid = character:FindFirstChildOfClass("Humanoid")
    local newRoot = character:FindFirstChild("HumanoidRootPart")
    if newRoot and not newRoot:IsA("BasePart") then newRoot = nil end
    local newAnimate = character:FindFirstChild("Animate")
    if newAnimate and not newAnimate:IsA("LocalScript") then newAnimate = nil end

    -- Restore the old body before assigning the new references.
    stopFlight()
    resetTarget()
    table.clear(Ignored)
    table.clear(Coins)
    clearDeathConnection()
    Humanoid, Root, Animate = newHumanoid, newRoot, newAnimate
    table.clear(BodyParts)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then BodyParts[part] = true end
    end
    NextAnimationCheck, NextCollisionCheck, NextCoinSearch = 0, 0, 0
    if newHumanoid then
        DeathConnection = connect(newHumanoid.Died, function()
            task.defer(function()
                if not Running or Character ~= character or Player.Character ~= character then return end
                if Humanoid ~= newHumanoid
                    or character:FindFirstChildOfClass("Humanoid") ~= newHumanoid then return end
                if newHumanoid.Health <= 0 then resetRound() end
            end)
        end, CharacterConnections)
    end
    if Enabled and RoundActive and not BagFull then
        Status = newRoot and newHumanoid and "Corpo atualizado; retomando coleta"
            or "Aguardando novas partes do corpo"
    end
end
local function bindCharacter(character)
    if not Running or Player.Character ~= character then return end
    BodyRevision = BodyRevision + 1
    resetRound()
    clearDeathConnection()
    disconnect(CharacterConnections)
    Character, Humanoid, Root, Animate = character, nil, nil, nil
    local pending = false
    local function scheduleRefresh(object)
        if not Running or Character ~= character then return end
        if object and not (object:IsA("BasePart") or object:IsA("Humanoid")
            or object.Name == "Animate") then return end
        -- Pause immediately while parts are being replaced. Coalesce the rest.
        stopFlight()
        resetTarget()
        if pending then return end
        pending = true
        local revision = BodyRevision
        task.defer(function()
            pending = false
            refreshBody(character, revision)
        end)
    end
    connect(character.DescendantAdded, scheduleRefresh, CharacterConnections)
    connect(character.DescendantRemoving, scheduleRefresh, CharacterConnections)
    refreshBody(character, BodyRevision)
end
connect(Player.CharacterAdded, bindCharacter)
connect(Player.CharacterRemoving, function(character)
    if character ~= Character then return end
    BodyRevision = BodyRevision + 1
    resetRound()
    clearDeathConnection()
    disconnect(CharacterConnections)
    Character, Humanoid, Root, Animate = nil, nil, nil, nil
end)
if Player.Character then bindCharacter(Player.Character) end

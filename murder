connect(RunService.Heartbeat, function(dt)
    if not Running then return end

    -- NOVO: RESET AUTOMÁTICO AO ENCHER
    if Enabled
        and RoundActive
        and BagFull
        and Config.ResetOnFullBag
        and not ResetRequested
        and validCharacter() then

        ResetRequested = true
        Status = "Resetando: saco cheio"

        resetFarm()

        -- Solicita o reset uma única vez.
        Humanoid.Health = 0

        return
    end

    if not Enabled
        or not RoundActive
        or BagFull
        or not validCharacter() then

        if Flying then
            resetFarm()
        end

        Status = not Enabled
            and "Desativado"
            or (
                BagFull
                and "Saco cheio"
                or "Aguardando partida"
            )

        return
    end

    if not Flying then
        startFlight()
    end

    holdPose()

    -- ====================================
    -- DESCIDA INICIAL
    -- ====================================

    if NeedsInitialDrop then
        if not InitialDropAttempted then
            InitialDropAttempted = true
            InitialDropTarget =
                findInitialDropPosition()
        end

        if InitialDropTarget then
            Status = "Descendo abaixo do piso..."
            DropStatus = "Descendo..."

            local reached = moveTo(
                InitialDropTarget,
                math.min(dt, 0.1)
            )

            if reached then
                NeedsInitialDrop = false
                InitialDropTarget = nil
                DropStatus = "Concluída"
                Status = "Procurando moedas..."
            end

            return
        else
            NeedsInitialDrop = false
            DropStatus = "Ignorada"
            Status = "Piso não detectado"
            return
        end
    end

    -- ====================================
    -- FARM DE MOEDAS
    -- ====================================

    if not Target then
        local now = os.clock()
        if now < NextCoinSearch then return end
        NextCoinSearch = now + Config.ScanInterval
        Target = nearestCoin()

        if Target then
            TargetPosition = getApproachPosition(Target)
            ReachedAt = nil
        else
            Status = "Procurando moedas..."
            return
        end
    end

    if not Target:IsDescendantOf(workspace) then
        resetTarget()
        return
    end

    if not TargetPosition then
        resetTarget()
        return
    end

    if not ReachedAt then
        Status = "Indo para baixo da moeda..."

        local reached = moveTo(
            TargetPosition,
            math.min(dt, 0.1)
        )

        if reached then
            ReachedAt = os.clock()
            Status = "Testando coleta por baixo..."
        end
    else
        Status = "Testando coleta por baixo..."
        holdPose()

        if os.clock() - ReachedAt
            >= Config.WaitTime then

            -- Visitada não significa coletada.
            Ignored[Target] = true
            resetTarget()
        end
    end
end)


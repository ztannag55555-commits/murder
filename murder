-- ====================================
-- CONEXÕES
-- ====================================

local function connect(signal, callback, list)
    local connection = signal:Connect(callback)
    table.insert(list or Connections, connection)
    return connection
end

local function disconnect(list)
    for _, connection in ipairs(list) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(list)
end

local function validCharacter()
    return Character
        and Character.Parent
        and Root
        and Root.Parent == Character
        and Humanoid
        and Humanoid.Parent == Character
        and Humanoid.Health > 0
        and Player.Character == Character
end

local function resetTarget()
    Target = nil
    TargetPosition = nil
    ReachedAt = nil
end

-- ====================================
-- ANIMAÇÕES
-- ====================================

local function stopAnimations()
    if not Humanoid then return end
    local now = os.clock()
    if now < NextAnimationCheck then return end
    NextAnimationCheck = now + 0.25

    local animator = Humanoid:FindFirstChildOfClass("Animator")

    if animator then
        for _, track in ipairs(
            animator:GetPlayingAnimationTracks()
        ) do
            track:Stop(0)
        end
    end
end

-- ====================================
-- NOCLIP
-- ====================================

local function noclip()
    if not Character then return end
    local now = os.clock()
    if now < NextCollisionCheck then return end
    NextCollisionCheck = now + 0.1
    for object in pairs(BodyParts) do
        if object:IsDescendantOf(Character) then
            if Collisions[object] == nil then Collisions[object] = object.CanCollide end
            if object.CanCollide then object.CanCollide = false end
        else
            BodyParts[object] = nil
        end
    end
end
local function restoreCollisions()
    for part, original in pairs(Collisions) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(Collisions)
end

-- ====================================
-- POSE DEITADA
-- ====================================

local function lieRotation()
    if not Original.Rotation then
        return nil
    end

    return Original.Rotation
        * CFrame.Angles(math.rad(90), 0, 0)
end

-- ====================================
-- PARAR VOO
-- ====================================

local function stopFlight()
    if Velocity then
        Velocity:Destroy()
        Velocity = nil
    end

    if Attachment then
        Attachment:Destroy()
        Attachment = nil
    end

    restoreCollisions()

    if Flying then
        if Root and Root.Parent then
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero

            if Original.Rotation then
                Root.CFrame =
                    CFrame.new(Root.Position)
                    * Original.Rotation
            end

            if Original.Anchored ~= nil then
                Root.Anchored = Original.Anchored
            end
        end

        if Humanoid and Humanoid.Parent then
            Humanoid.AutoRotate = Original.AutoRotate
            Humanoid.PlatformStand = Original.PlatformStand
        end

        if Animate and Animate.Parent
            and Original.AnimateDisabled ~= nil then
            Animate.Disabled = Original.AnimateDisabled
        end
    end

    Flying = false
    table.clear(Original)
end

-- ====================================
-- INICIAR VOO
-- ====================================

local function startFlight()
    if Flying or not validCharacter() then
        return
    end

    Original.Rotation = Root.CFrame - Root.Position
    Original.AutoRotate = Humanoid.AutoRotate
    Original.PlatformStand = Humanoid.PlatformStand
    Original.Anchored = Root.Anchored

    if Animate then
        Original.AnimateDisabled = Animate.Disabled
        Animate.Disabled = true
    end

    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = false
    Root.Anchored = false

    stopAnimations()

    Attachment = Instance.new("Attachment")
    Attachment.Name = "ZYON_V76_Attachment"
    Attachment.Parent = Root

    Velocity = Instance.new("LinearVelocity")
    Velocity.Name = "ZYON_V76_Flight"
    Velocity.Attachment0 = Attachment
    Velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    Velocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    Velocity.VectorVelocity = Vector3.zero
    Velocity.ForceLimitsEnabled = false
    Velocity.MaxForce = math.huge
    Velocity.Parent = Root

    Flying = true
    NextAnimationCheck, NextCollisionCheck = 0, 0
    noclip()
end

-- ====================================
-- MANTER DEITADO
-- ====================================

local function holdPose()
    if not Flying or not validCharacter() then
        return
    end

    local rotation = lieRotation()

    if rotation then
        Root.CFrame =
            CFrame.new(Root.Position) * rotation
    end

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    if Velocity then
        Velocity.VectorVelocity = Vector3.zero
    end

    noclip()
    stopAnimations()
end

-- ====================================
-- MOVIMENTO
-- ====================================

local function moveTo(position, dt)
    if not validCharacter() then
        return false
    end

    local delta = position - Root.Position
    local distance = delta.Magnitude

    if distance <= 0.15 then
        holdPose()
        return true
    end

    local step = math.min(Config.Speed * dt, distance)
    local nextPosition = Root.Position + delta.Unit * step

    local rotation = lieRotation()

    if rotation then
        Root.CFrame =
            CFrame.new(nextPosition) * rotation
    end

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    return false
end

-- ====================================
-- MOEDAS
-- ====================================

local function coinPosition(coin)
    if not coin then return nil end

    if coin:IsA("BasePart") then
        return coin.Position
    end

    if coin:IsA("Model") then
        return coin:GetPivot().Position
    end

    return nil
end

local function isEligibleCoin(object)
    if not Config.FarmEvento then return false end
    if not object:IsA("BasePart") or object.Name ~= "Coin_Server" then
        return false
    end
    -- CoinContainer pode estar dentro de qualquer mapa.
    local parent = object.Parent
    while parent and parent ~= workspace do
        if parent.Name == "CoinContainer" then return true end
        parent = parent.Parent
    end
    return false
end

-- One initial scan; subsequent updates inspect only cached coin candidates.
local function indexCoin(object)
    if object:IsA("BasePart") and object.Name == "Coin_Server" then
        CoinCandidates[object] = true
    end
end
connect(workspace.DescendantAdded, indexCoin)
connect(workspace.DescendantRemoving, function(object)
    CoinCandidates[object], Ignored[object] = nil, nil
end)
task.defer(function()
    if not Running then return end
    local initial = workspace:GetDescendants()
    for i, object in ipairs(initial) do
        if not Running then return end
        if object:IsDescendantOf(workspace) then indexCoin(object) end
        if i % 256 == 0 then task.wait() end
    end
    table.clear(initial)
end)
local function refreshCoins()
    table.clear(Coins)
    if not Enabled or not Config.FarmEvento then return end
    for object in pairs(CoinCandidates) do
        if object:IsDescendantOf(workspace) and isEligibleCoin(object) then
            table.insert(Coins, object)
        end
    end
end
local function nearestCoin()
    if not validCharacter() then
        return nil
    end

    local nearest
    local nearestDistance = math.huge

    for _, coin in ipairs(Coins) do
        if coin:IsDescendantOf(workspace)
            and not Ignored[coin] then

            local position = coinPosition(coin)

            if position then
                local distance =
                    (position - Root.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = coin
                end
            end
        end
    end

    return nearest
end

-- ====================================
-- POSIÇÃO ABAIXO DA MOEDA
-- ====================================

local function getApproachPosition(coin)
    local position = coinPosition(coin)

    if not position then
        return nil
    end

    -- Distância padrão: 1.5 studs
    return position - Vector3.new(
        0,
        Config.Distance,
        0
    )
end

-- ====================================
-- DESCIDA INICIAL
-- ====================================

local function findInitialDropPosition()
    if not validCharacter() then
        return nil
    end

    local origin = Root.Position

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}
    params.IgnoreWater = true

    local result = workspace:Raycast(
        origin,
        Vector3.new(0, -100, 0),
        params
    )

    if not result then
        return nil
    end

    local desiredY =
        result.Position.Y - Config.InitialDrop

    local totalDescent = origin.Y - desiredY

    if totalDescent < 0
        or totalDescent > Config.MaxInitialDescent then
        return nil
    end

    return Vector3.new(
        origin.X,
        desiredY,
        origin.Z
    )
end

local function resetInitialDrop()
    NeedsInitialDrop = true
    InitialDropTarget = nil
    InitialDropAttempted = false
    DropStatus = "Pendente"
end


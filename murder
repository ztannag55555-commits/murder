local Gesture
local RequestedSize = Vector2.new(300, 180)
local function bounds()
    local camera = workspace.CurrentCamera
    local size = camera and camera.ViewportSize or Vector2.new(800, 600)
    local topLeft, bottomRight = GuiService:GetGuiInset()
    return Vector2.new(math.max(1, size.X - topLeft.X - bottomRight.X),
        math.max(1, size.Y - topLeft.Y - bottomRight.Y))
end
local function clampObject(object, screen)
    local p = object.Position
    local size = Vector2.new(object.Size.X.Offset, object.Size.Y.Offset)
    object.Position = UDim2.fromOffset(
        math.clamp(p.X.Scale * screen.X + p.X.Offset, 0, math.max(0, screen.X - size.X)),
        math.clamp(p.Y.Scale * screen.Y + p.Y.Offset, 0, math.max(0, screen.Y - size.Y)))
end
local function fit()
    local screen = bounds()
    local w = math.clamp(RequestedSize.X, math.min(300, screen.X), screen.X)
    local h = math.clamp(RequestedSize.Y, math.min(180, screen.Y), screen.Y)
    Main.Size = UDim2.fromOffset(w, h)
    local scale = math.min(1, math.max(0.01, (w - 6) / 440))
    ContentScale.Scale = scale
    Content.Position = UDim2.fromOffset(math.max(0, (w - 440 * scale) / 2), 0)
    Scroll.CanvasSize = UDim2.fromOffset(0, 574 * scale)
    Floating.Size = UDim2.fromOffset(math.min(78, screen.X), math.min(36, screen.Y))
    clampObject(Main, screen)
    clampObject(Floating, screen)
end
local function setVisible(visible)
    Gesture = nil
    Main.Visible = visible
    Floating.Visible = not visible
    fit()
end
connect(Minimize.Activated, function() setVisible(false) end)
connect(UIS.InputBegan, function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        setVisible(not Main.Visible)
    end
end)
local function inside(object, point)
    local p, size = object.AbsolutePosition, object.AbsoluteSize
    return point.X >= p.X and point.Y >= p.Y
        and point.X <= p.X + size.X and point.Y <= p.Y + size.Y
end
local function beginGesture(mode, object, input)
    if Gesture then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    fit()
    Gesture = {mode = mode, object = object, input = input,
        start = input.Position, position = object.Position,
        size = Main.AbsoluteSize, moved = false}
end
connect(Top.InputBegan, function(input)
    if inside(Close, input.Position) or inside(Minimize, input.Position) then return end
    beginGesture("move", Main, input)
end)
connect(Floating.InputBegan, function(input) beginGesture("floating", Floating, input) end)
connect(Resize.InputBegan, function(input) beginGesture("resize", Main, input) end)
connect(UIS.InputChanged, function(input)
    local g = Gesture
    if not g then return end
    local mouse = g.input.UserInputType == Enum.UserInputType.MouseButton1
    if input ~= g.input and not (mouse and input.UserInputType == Enum.UserInputType.MouseMovement) then return end
    local delta = input.Position - g.start
    if delta.Magnitude >= 7 then g.moved = true end
    if not g.moved then return end
    if g.mode == "resize" then
        local screen = bounds()
        RequestedSize = Vector2.new(
            math.clamp(g.size.X + delta.X, math.min(300, screen.X), screen.X),
            math.clamp(g.size.Y + delta.Y, math.min(180, screen.Y), screen.Y))
    else
        g.object.Position = UDim2.fromOffset(g.position.X.Offset + delta.X,
            g.position.Y.Offset + delta.Y)
    end
    fit()
end)
connect(UIS.InputEnded, function(input)
    local g = Gesture
    if not g or input ~= g.input then return end
    Gesture = nil
    local moved = g.moved or (input.Position - g.start).Magnitude >= 7
    if g.mode == "floating" and not moved and inside(Floating, input.Position) then
        setVisible(true)
    end
end)
connect(Floating.Activated, function(input)
    if input and (input.UserInputType == Enum.UserInputType.Keyboard
        or input.UserInputType.Name:match("Gamepad")) then setVisible(true) end
end)
